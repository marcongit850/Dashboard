{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "f1c59948520f1ec39473238b621c7e24",
  // workers.dev stays on. No schedule, and no custom domain for this Worker.
  // Path routes only. The apex custom domain stays on the whatshappening Worker.
  // These patterns run first for /dash and do not replace the rest of the site.
  "workers_dev": true,
  "routes": [
    { "pattern": "whatshappeningnetwork.com/dash", "zone_name": "whatshappeningnetwork.com" },
    { "pattern": "whatshappeningnetwork.com/dash/*", "zone_name": "whatshappeningnetwork.com" }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    // Team HQ Log workbook, posts tab.
    // Columns: posted_at_ct, bot, site, platform, account, status, topic, post_url, reach, clicks, signups, notes.
    "POSTS_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vR4YQ0rN83UR_XTThxjGrn5r0xdlaOvWw81y82J17xL7rkHfrYgInaGJEGxUr8YbhQz960rsMsVkDgT/pub?single=true&output=csv&gid=1635855641",
    // Team HQ Log workbook, status tab.
    // Columns: timestamp_ct, bot, state, task, link, needs_marc.
    // state is started, finished, blocked, or idle. needs_marc is yes or no.
    "STATUS_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vR4YQ0rN83UR_XTThxjGrn5r0xdlaOvWw81y82J17xL7rkHfrYgInaGJEGxUr8YbhQz960rsMsVkDgT/pub?single=true&output=csv&gid=0",
    // Published Key docs and sheets tab only. Do not add another gid from this workbook.
    // Columns: Name, Link, What it is, Owner bot.
    "DOCS_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vTYmooIL4KTClxzpJUdy2g30OIh4_Dudq7AQF181dZeZA9DS7Tx-fOfIowmVYD4ES8iCmRBV1kRQRYi/pub?single=true&output=csv&gid=1034259486",
    // JSON object of repo name to bot name. Overrides default GitHub attribution.
    "BOT_REPO_MAP": "{}",
    // Set both to verify Cloudflare Access. Leave both empty to skip that check.
    // ACCESS_TEAM_DOMAIN example: https://your-team.cloudflareaccess.com
    "ACCESS_AUD": "",
    "ACCESS_TEAM_DOMAIN": "",
    // Public path prefix. The dashboard, login, assets, and links all live under it.
    "BASE_PATH": "/dash"
  }
}
